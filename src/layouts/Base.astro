---
import '../styles/global.css';
import '../styles/glass.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { canonicalUrl } from '../lib/site';
import { getData } from '../lib/data';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
}
const { title, description, bodyClass = '', noindex = false } = Astro.props;
const { site } = await getData();
const canonical = canonicalUrl(site, Astro.url.pathname);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description,
  url: site.canonical,
  email: site.email,
  sameAs: [site.instagram],
  areaServed: ['India', 'Worldwide'],
  knowsAbout: [
    'Brand strategy',
    'Social media management',
    'Photography and videography',
    'Short-form video',
    'Instagram growth',
    'Meta advertising',
    'Influencer marketing',
    'Website development',
    'AI automation',
    'Digital marketing strategy',
    'Custom SaaS engineering',
    'SaaS MVP development',
    'Cloud and AI platforms',
    'Mobile app development',
    'Application maintenance',
    'Website care and security',
    'Full-stack maintenance',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/zannid-logo.png" type="image/png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="theme-color" content="#f4f1f8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
