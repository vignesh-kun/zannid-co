---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { content, siteConfig } from '../lib/site';
const page = content.aboutPage;
---
<Base
  title="About | A growth team, not a content vendor · Zannid & Co."
  description="Zannid & Co. is a strategy-led growth agency for brands in India and worldwide. One team for strategy, content, paid media and automation, measured on growth."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="display">{page.title}</h1>
      <p class="lede">{page.lede}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="stat-band glass" data-reveal>
        {page.numbers.map((number) => (
          <div>
            <b>{number.value}</b>
            <span>{number.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight story">
    <div class="wrap">
      <div class="story-grid">
        <div data-reveal>
          <p class="eyebrow">Our story</p>
          <h2 class="display">{page.storyTitle}</h2>
        </div>
        <div class="story-body" data-reveal data-delay="1">
          {page.story.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href="/work" style="justify-self:start">See the client wall <Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Operating principles</p>
          <h2 class="display">{page.principlesTitle}</h2>
        </div>
      </div>
      <div class="principle-grid">
        {page.principles.map((principle, i) => (
          <article class="principle" data-reveal data-delay={String(i % 3)}>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="cta-panel glass" data-reveal>
        <p class="eyebrow" style="justify-content:center">Let's build it</p>
        <h2 class="display">Good work deserves an audience.</h2>
        <p class="lede">Tell us what you are trying to grow. We will tell you what we would do first, and whether we are the right team for it.</p>
        <div class="actions">
          <a class="btn" href="/contact">Book a Free Consultation <Icon name="arrow" /></a>
          <a class="btn ghost" href="/audit">Get my free growth audit</a>
        </div>
        <p class="micro" style="margin-top:18px">{siteConfig.email} · {siteConfig.instagramHandle}</p>
      </div>
    </div>
  </section>
</Base>
