---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getData } from '../lib/data';
import { initials } from '../lib/site';
const { about, site } = await getData();
const page = about;
const place = page.location;
---
<Base
  title="About | A growth team, not a content vendor · Zannid & Co."
  description={`Zannid & Co. is a strategy-led growth agency for brands in India and worldwide. Based in ${place.city || 'Hyderabad'}, working everywhere.`}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="display">{page.title}</h1>
      <p class="lede">{page.lede}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="stat-band glass" data-reveal>
        {page.numbers.map((number) => (
          <div>
            <b>{number.value}</b>
            <span>{number.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight story">
    <div class="wrap">
      <div class="story-grid">
        <div data-reveal>
          <p class="eyebrow">Our story</p>
          <h2 class="display">{page.storyTitle}</h2>
        </div>
        <div class="story-body" data-reveal data-delay="1">
          {page.story.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href="/work" style="justify-self:start">See the work <Icon name="arrow" size={15} /></a>
        </div>
        <figure class="story-media" data-reveal>
          <img
            src="/assets/img/set-wide.jpg"
            alt="A Zannid & Co. studio set lit for a brand shoot"
            width="1392"
            height="752"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Operating principles</p>
          <h2 class="display">{page.valuesTitle}</h2>
        </div>
      </div>
      <div class="principle-grid">
        {page.values.map((value, i) => (
          <article class="principle" data-reveal data-delay={String(i % 3)}>
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {page.team.length > 0 && (
    <section class="section-tight" aria-labelledby="team-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">The team</p>
            <h2 class="display" id="team-title">The people on it.</h2>
          </div>
        </div>
        <div class="team-grid">
          {page.team.map((member, i) => (
            <article class="team-card glass" data-reveal data-delay={String(i % 3)}>
              {member.image ? (
                <img class="team-avatar has-image" src={member.image} alt={member.name} loading="lazy" />
              ) : (
                <span class="team-avatar" aria-hidden="true">{initials(member.name)}</span>
              )}
              <h3>{member.name}</h3>
              <p class="team-role">{member.role}</p>
              <p class="team-bio">{member.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-tight" aria-labelledby="where-title">
    <div class="wrap">
      <div class="studio-card glass" data-reveal>
        <div>
          <p class="eyebrow">Where we work</p>
          <h2 class="display" id="where-title">{place.city}{place.region ? `, ${place.region}` : ''}</h2>
          {place.address && <p class="lede">{place.address}</p>}
          <p class="micro">{place.note}</p>
        </div>
        <ul class="studio-meta">
          {site.hours && <li><Icon name="clock" size={16} /><span>{site.hours}</span></li>}
          {site.email && <li><Icon name="mail" size={16} /><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          {place.mapUrl && (
            <li>
              <Icon name="arrow-up-right" size={16} />
              <a href={place.mapUrl} target="_blank" rel="noopener">Open in maps</a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="cta-panel glass" data-reveal>
        <p class="eyebrow" style="justify-content:center">Let's build it</p>
        <h2 class="display">Good work deserves an audience.</h2>
        <p class="lede">Tell us what you are trying to grow. We will tell you what we would do first, and whether we are the right team for it.</p>
        <div class="actions">
          <a class="btn" href="/contact">Book a Free Consultation <Icon name="arrow" /></a>
          <a class="btn ghost" href="/audit">Get my free growth audit</a>
        </div>
        <p class="micro" style="margin-top:18px">{site.email} · {site.instagramHandle}</p>
      </div>
    </div>
  </section>
</Base>
