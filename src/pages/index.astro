---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { initials } from '../lib/site';
import { getData } from '../lib/data';

const { clients, content, site } = await getData();
const home = content.home;
const marquee = [...clients, ...clients];
const city = site.city || 'Hyderabad';
const gallery = [
  {
    src: '/assets/img/strategy.jpg',
    label: 'Brand & strategy',
    kicker: 'Week one',
    href: '/services#branding-and-brand-strategy',
    alt: 'A brand workshop table with printed moodboards and colour swatches',
  },
  {
    src: '/assets/img/shoot.jpg',
    label: 'Reels & content',
    kicker: 'On set',
    href: '/services',
    alt: 'A short-form video shoot in progress with a camera on a gimbal',
  },
  {
    src: '/assets/img/performance.jpg',
    label: 'Growth & ads',
    kicker: 'Every week',
    href: '/services',
    alt: 'A laptop and phone showing colourful performance charts on a glass desk',
  },
  {
    src: '/assets/img/set-wide.jpg',
    label: 'Studio & production',
    kicker: 'In house',
    href: '/work',
    alt: 'A colour-graded studio set with softboxes and a gradient backdrop',
  },
];
---
<Base
  title="Zannid & Co. | Growth agency for brands that refuse to be ignored"
  description="Strategy, reels, Meta ads, creators, websites and AI automations from one growth team. Working with brands across India and worldwide. Claim a free growth audit."
  bodyClass="home"
>
  <section class="hero section" id="top" data-label="Start">
    <div class="shader-field" aria-hidden="true"><canvas data-shader></canvas></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="display">
          {home.hero.titleBefore} <span class="accent">{home.hero.titleAccent}</span>
        </h1>
        <p class="lede">{home.hero.lede}</p>
        <div class="actions">
          <a class="btn" href="/contact">{home.hero.primary} <Icon name="arrow" /></a>
          <a class="btn ghost" href="/audit">{home.hero.secondary}</a>
        </div>
        <p class="hero-note">{home.hero.note}</p>
        <p class="hero-hint" aria-hidden="true"><span></span> Scroll. You can see the work.</p>
      </div>

      <div class="hero-visual" data-reveal>
        <figure class="hero-shot">
          <img
            src="/assets/img/studio-team.jpg"
            alt="The Zannid & Co. team reviewing a brand board in the studio"
            width="880"
            height="1184"
            fetchpriority="high"
          />
        </figure>
        <div class="hero-badge glass">
          <span class="mono">{city} · Worldwide</span>
          <b>Strategy, reels, ads and web from one team.</b>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="problem" data-label="Real talk" aria-labelledby="problem-title">
    <div class="wrap orbit">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{home.problems.eyebrow}</p>
          <h2 class="display" id="problem-title">{home.problems.title}</h2>
          <p class="lede">{home.problems.intro}</p>
        </div>
      </div>
      <div class="problem-grid">
        {home.problems.cards.map((card, i) => (
          <article class="problem-card card glass" data-reveal data-delay={String(i)}>
            <p class="num-tag">0{i + 1}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
      <div class="fix-line glass" data-reveal>
        <Icon name="spark" size={22} />
        <span>{home.problems.fix}</span>
        <a class="text-link" href="/about">How we work <Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <section class="section-tight" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap orbit">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">In the room</p>
          <h2 class="display" id="gallery-title">See what you are buying.</h2>
          <p class="lede">
            Strategy sessions, sets, edits and ad dashboards. The work is visual before it is verbal,
            so here is the shape of it.
          </p>
        </div>
        <a class="text-link" href="/services">All services <Icon name="arrow" size={15} /></a>
      </div>
      <div class="media-rail">
        {gallery.map((item, i) => (
          <a class="media-card" href={item.href} data-reveal data-delay={String(i % 3)}>
            <img src={item.src} alt={item.alt} width="880" height="1184" loading="lazy" />
            <span class="media-cap">
              {item.label}
              <span>{item.kicker}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="results" data-label="Results" aria-labelledby="results-title">
    <div class="wrap orbit">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{home.results.eyebrow}</p>
          <h2 class="display" id="results-title">{home.results.title}</h2>
        </div>
      </div>
      <div class="results-grid">
        <article class="reach-card card glass panel" data-reveal>
          <div>
            <p class="num-tag">Growth plan target, week 12</p>
            <p class="reach-number">{home.results.multiple}</p>
            <p>{home.results.multipleLabel}</p>
          </div>
          <p class="hint-line">Plan target, not a past client guarantee</p>
        </article>
        <article class="funnel-card card glass panel" data-reveal data-delay="1">
          <div class="funnel-head">
            <h3>{home.results.funnelTitle}</h3>
            <span class="badge">{home.results.funnelBadge}</span>
          </div>
          <div class="funnel">
            {home.results.funnelSteps.map((step) => (
              <div class="funnel-row">
                <span>{step.label}</span>
                <span class="funnel-bar"><span class="funnel-fill" style={`width:${step.width}%`} /></span>
                <b>{step.value}</b>
              </div>
            ))}
          </div>
          <p class="micro">{home.results.funnelNote}</p>
        </article>
      </div>
      <div class="metric-row glass" data-reveal>
        {home.results.metrics.map((metric) => (
          <div class="metric">
            <b>{metric.value}</b>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="proof" data-label="Why it works" aria-labelledby="proof-title">
    <div class="wrap orbit">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{home.proof.eyebrow}</p>
          <h2 class="display" id="proof-title">{home.proof.title}</h2>
          <p class="lede">{home.proof.intro}</p>
        </div>
      </div>
      <div class="proof-grid">
        {home.proof.points.map((point, i) => (
          <article class="proof-card card glass" data-reveal data-delay={String(i)}>
            <p class="proof-value">{point.value}</p>
            <p>{point.text}</p>
            <cite>{point.source}</cite>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="showcase-title">
    <div class="wrap orbit">
      <figure class="showcase" data-reveal>
        <img
          src="/assets/img/set-wide.jpg"
          alt="A studio set lit for a brand shoot, with a violet to peach gradient backdrop"
          width="1392"
          height="752"
          loading="lazy"
        />
        <figcaption class="showcase-caption glass">
          <p class="eyebrow">On set</p>
          <h2 id="showcase-title">Light, colour and framing decided before the first frame.</h2>
          <a class="text-link" href="/work">See the work <Icon name="arrow" size={15} /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="logo-strip section-tight" aria-labelledby="clients-title">
    <div class="wrap orbit">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{home.clients.eyebrow}</p>
          <h2 class="display" id="clients-title">{home.clients.title}</h2>
        </div>
        <a class="text-link" href="/clients">See the client wall <Icon name="arrow" size={15} /></a>
      </div>
      <div class="logo-marquee" data-reveal>
        <div class="logo-track">
          {marquee.map((client, i) => (
            <div class:list={['logo-tile', { dup: i >= clients.length }]} aria-hidden={i >= clients.length ? 'true' : undefined}>
              <span class="logo-mark" aria-hidden="true">{initials(client.name)}</span>
              <span>{client.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="process" data-label="Process" aria-labelledby="process-title">
    <div class="wrap orbit">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{home.process.eyebrow}</p>
          <h2 class="display" id="process-title">{home.process.title}</h2>
          <p class="lede">{home.process.intro}</p>
        </div>
      </div>
      <div class="process-grid">
        {home.process.steps.map((step, i) => (
          <article class="step-card card glass" data-reveal data-delay={String(i % 2)}>
            <span class="step-when">{step.when}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <p class="step-fact">{step.fact}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="start" data-label="Let's talk" aria-labelledby="start-title">
    <div class="wrap orbit">
      <div class="cta-panel glass" data-reveal>
        <p class="eyebrow" style="justify-content:center">{home.final.eyebrow}</p>
        <h2 class="display" id="start-title">{home.final.title}</h2>
        <p class="lede">{home.final.body}</p>
        <div class="actions">
          <a class="btn" href="/audit">{home.final.primary} <Icon name="arrow" /></a>
          <a class="btn ghost" href="/contact">{home.final.secondary}</a>
        </div>
        <p class="micro">{home.final.note}</p>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/shader';
  </script>
</Base>
