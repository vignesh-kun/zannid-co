---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { bundles, content, faqGroup, serviceTitle } from '../lib/site';

const page = content.pricingPage;
const faqs = faqGroup('Pricing');
---

<Base
  title="Pricing | Scoped, then quoted · Zannid & Co."
  description="No rate card. Every Zannid & Co. engagement is scoped on a short call, then quoted in writing within two working days. Starter, Growth and Scale shapes."
>
  <section class="page-hero pricing-hero">
    <div class="wrap pricing-hero-grid">
      <h1 class="display">{page.title}</h1>
      <div class="pricing-hero-side">
        <p class="lede">{page.lede}</p>
        <ul class="pricing-promise">
          {page.promise.map((item) => <li><Icon name="check" size={15} />{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="bundles-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 class="display" id="bundles-title">{page.bundlesTitle}</h2>
          <p class="lede">{page.bundlesLede}</p>
        </div>
      </div>

      <div class="engage-grid">
        {bundles.map((bundle, i) => (
          <article
            class:list={['engage', 'glass', { featured: bundle.mostChosen }]}
            data-reveal
            data-delay={String(i)}
          >
            <div class="engage-top">
              <h3 class="display">{bundle.name}</h3>
              {bundle.mostChosen && <span class="tag">Most chosen</span>}
            </div>
            <p class="tagline">{bundle.tagline}</p>
            <p class="engage-best">{bundle.bestFor}</p>
            <p class="quote-line">
              <span class="mono">Quoted monthly</span>
              <span>after a scoping call</span>
            </p>
            <ul>
              {bundle.includes.map((slug) => (
                <li><Icon name="check" size={15} />{serviceTitle(slug)}</li>
              ))}
            </ul>
            <a class:list={['btn', 'wide', { ghost: !bundle.mostChosen }]} href={`/contact?bundle=${bundle.slug}`}>
              Ask for the {bundle.name} quote
              {bundle.mostChosen && <Icon name="arrow" size={16} />}
            </a>
            <p class="note">{bundle.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="factors-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 class="display" id="factors-title">{page.factorsTitle}</h2>
          <p class="lede">{page.factorsLede}</p>
        </div>
      </div>
      <div class="factor-grid" data-reveal>
        {page.factors.map((factor) => (
          <article class="factor">
            <h3>{factor.title}</h3>
            <p>{factor.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="flow-title">
    <div class="wrap quote-flow">
      <div class="quote-flow-head" data-reveal>
        <h2 class="display" id="flow-title">{page.quoteTitle}</h2>
        <p class="lede">{page.quoteLede}</p>
      </div>
      <ol class="quote-steps">
        {page.quoteSteps.map((step, i) => (
          <li data-reveal data-delay={String(i)}>
            <span class="mono">0{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="pricing-faq-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 class="display" id="pricing-faq-title">{page.faqTitle}</h2>
        </div>
      </div>
      <div class="faq-list glass" data-reveal>
        {faqs.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{faq.q}<Icon name="plus" size={20} /></summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
      <div class="actions" style="margin-top:28px">
        <a class="btn" href="/contact">Ask a pricing question <Icon name="arrow" /></a>
        <a class="btn ghost" href="/audit">Get a free audit first</a>
      </div>
    </div>
  </section>
</Base>
