---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getData } from '../lib/data';
const { work, content } = await getData();
const page = content.workPage;
---
<Base
  title="Work | Case studies and reels · Zannid & Co."
  description="Case studies from Zannid & Co. across food, retail, real estate, education, events and production. See how the work is built and what it was for."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="display">{page.title}</h1>
      <p class="lede">{page.lede}</p>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="wrap">
      <figure class="work-band" data-reveal>
        <img
          src="/assets/img/set-wide.jpg"
          alt="A studio set lit for a brand shoot"
          width="1392"
          height="752"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="reels-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Case studies</p>
          <h2 class="display" id="reels-title">{page.reelsTitle}</h2>
          <p class="lede">{page.reelsNote}</p>
        </div>
        <a class="text-link" href="/clients">The client wall <Icon name="arrow" size={15} /></a>
      </div>

      <div class="reel-grid">
        {work.map((item, i) => {
          const href = item.href || '';
          const external = href.startsWith('http');
          return (
            <a
              class="reel-card glass"
              href={href || '/contact'}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              aria-label={`${item.title}${item.tag ? `: ${item.tag}` : ''}${item.stat ? `, ${item.stat}` : ''}`}
              data-reveal
              data-delay={String(i)}
            >
              {item.image ? (
                <div class="reel-poster has-image">
                  <img src={item.image} alt="" loading="lazy" />
                  <span class="reel-tag">{item.tag}</span>
                  <span class="reel-quote">{item.title}</span>
                </div>
              ) : (
                <div class="reel-poster" style={`background: linear-gradient(160deg, ${item.from}, ${item.to})`}>
                  <span class="reel-tag">{item.tag}</span>
                  <span class="reel-play" aria-hidden="true"><Icon name="play" size={22} /></span>
                  <span class="reel-quote">{item.title}</span>
                </div>
              )}
              <div class="reel-body">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <div class="reel-meta">
                  <span>{item.client || 'Case study'}</span>
                  {item.stat && <span class="mono">{item.stat}</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="cta-panel glass" data-reveal>
        <p class="eyebrow" style="justify-content:center">Your brand next</p>
        <h2 class="display">Let's make something people stop for.</h2>
        <p class="lede">Start with a free audit. We will show you the content, offer and channel mix we would test first.</p>
        <div class="actions">
          <a class="btn" href="/audit">Get my free growth audit <Icon name="arrow" /></a>
          <a class="btn ghost" href="/contact">Book a Free Consultation</a>
        </div>
      </div>
    </div>
  </section>
</Base>
