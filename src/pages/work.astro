---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { clients, content, initials, siteConfig, work } from '../lib/site';
const page = content.workPage;
---
<Base
  title="Work | Reels and the client wall · Zannid & Co."
  description="Case-study reels from Zannid & Co. and 25 brands across food, retail, real estate, education, events and production. See how the work is built."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="display">{page.title}</h1>
      <p class="lede">{page.lede}</p>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="reels-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Selected reels</p>
          <h2 class="display" id="reels-title">{page.reelsTitle}</h2>
          <p class="lede">{page.reelsNote}</p>
        </div>
        <a class="text-link" href={siteConfig.instagram} target="_blank" rel="noopener">
          More on Instagram <Icon name="arrow-up-right" size={15} />
        </a>
      </div>

      <div class="reel-grid">
        {work.map((reel, i) => (
          <a
            class="reel-card glass"
            href={reel.href}
            target="_blank"
            rel="noopener"
            aria-label={`${reel.title}: ${reel.tag}, ${reel.stat}. Opens Instagram.`}
            data-reveal
            data-delay={String(i)}
          >
            <div class="reel-poster" style={`background: linear-gradient(160deg, ${reel.from}, ${reel.to})`}>
              <span class="reel-tag">{reel.tag}</span>
              <span class="reel-play" aria-hidden="true"><Icon name="play" size={22} /></span>
              <span class="reel-quote">{reel.title}</span>
            </div>
            <div class="reel-body">
              <h3>{reel.title}</h3>
              <p>{reel.text}</p>
              <div class="reel-meta">
                <span>Case-study reel</span>
                <span class="mono">{reel.stat}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="wall-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">The client wall</p>
          <h2 class="display" id="wall-title">{page.clientsTitle}</h2>
          <p class="lede">{page.clientsLede}</p>
        </div>
      </div>
      <div class="client-grid">
        {clients.map((client, i) => (
          <article class="client-tile" data-reveal data-delay={String(i % 3)}>
            <span class="client-mark" aria-hidden="true">{initials(client.name)}</span>
            <strong>{client.name}</strong>
            <span>{client.description}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="cta-panel glass" data-reveal>
        <p class="eyebrow" style="justify-content:center">Your brand next</p>
        <h2 class="display">Let's make something people stop for.</h2>
        <p class="lede">Start with a free audit. We will show you the content, offer and channel mix we would test first.</p>
        <div class="actions">
          <a class="btn" href="/audit">Get my free growth audit <Icon name="arrow" /></a>
          <a class="btn ghost" href="/contact">Book a Free Consultation</a>
        </div>
      </div>
    </div>
  </section>
</Base>
