---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {
  canonicalUrl,
  content,
  groupFor,
  relatedServices,
  services,
  siteConfig,
  type Service,
} from '../../lib/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const group = groupFor(service);
const related = relatedServices(service);
const pageTitle = `${service.title} | ${service.summary.replace(/\.$/, '')} · Zannid & Co.`;
const description = `${service.summary} ${service.options.length} ways to scope it. Quoted per engagement.`.slice(0, 158);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.summary,
  url: canonicalUrl(`/services/${service.slug}`),
  provider: { '@type': 'ProfessionalService', name: 'Zannid & Co.', url: siteConfig.canonical },
  areaServed: ['India', 'Worldwide'],
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: canonicalUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Services', item: canonicalUrl('/services') },
    { '@type': 'ListItem', position: 3, name: service.title, item: canonicalUrl(`/services/${service.slug}`) },
  ],
};
---

<Base title={pageTitle} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />

  <section class="svc-detail">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/services">Services</a><span aria-hidden="true">/</span>
        <span aria-current="page">{service.shortTitle}</span>
      </nav>

      <div class="svc-detail-grid">
        <div class="svc-detail-head">
          <h1 class="display">{service.title}</h1>
          <p class="lede">{service.summary}</p>
          <div class="svc-meta">
            {group && <span class="svc-chip">{group.title}</span>}
            <span class="svc-chip">{service.options.length} options</span>
            <span class="svc-chip">Pricing quoted per scope</span>
          </div>
          <div class="actions">
            <a class="btn" href={`/contact?service=${service.slug}`}>
              Get a quote <Icon name="arrow" />
            </a>
            <a class="btn ghost" href="/audit">Free growth audit</a>
          </div>
        </div>

        <aside class="scope-card glass" aria-labelledby="scope-heading">
          <p class="scope-label">Pricing</p>
          <h2 class="display" id="scope-heading">Quoted, not guessed.</h2>
          <p>
            Tell us the goal and the deadline. We send a written scope, a price and a start date
            within two working days.
          </p>
          <ul class="scope-list">
            <li><Icon name="check" size={15} /><span>20-minute scoping call</span></li>
            <li><Icon name="check" size={15} /><span>Written scope before any number</span></li>
            <li><Icon name="check" size={15} /><span>Fixed project price or monthly rate</span></li>
          </ul>
          <a class="btn wide" href={`/contact?service=${service.slug}`}>
            Ask for a quote <Icon name="arrow" size={16} />
          </a>
          <p class="micro">No rate card. No surprise line items.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="options-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 class="display" id="options-title">Pick the option that fits.</h2>
          <p class="lede">
            Same team, same standard. The scope changes, not the quality. Each option is quoted
            after a short call.
          </p>
        </div>
      </div>

      <div class="opt-grid">
        {service.options.map((option, i) => (
          <article class="opt-card glass" data-reveal data-delay={String(i)}>
            <div class="opt-card-top">
              <span class="opt-time mono">{option.timeline}</span>
              <Icon name={service.icon as 'compass'} size={19} />
            </div>
            <h3>{option.name}</h3>
            <p class="opt-best">{option.bestFor}</p>
            <ul>
              {option.includes.map((item) => (
                <li><Icon name="check" size={15} /><span>{item}</span></li>
              ))}
            </ul>
            <a
              class="text-link"
              href={`/contact?service=${service.slug}&option=${encodeURIComponent(option.name)}`}
            >
              Ask about this option <Icon name="arrow" size={15} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="run-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 class="display" id="run-title">From first call to measured result.</h2>
          <p class="lede">{content.home.process.intro}</p>
        </div>
      </div>
      <div class="process-grid">
        {content.home.process.steps.slice(0, 4).map((step, i) => (
          <article class="step-card card glass" data-reveal data-delay={String(i % 2)}>
            <span class="step-when">{step.when}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <p class="step-fact">{step.fact}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="related-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 class="display" id="related-title">Often paired with.</h2>
        </div>
      </div>
      <div class="related-grid">
        {related.map((item) => (
          <a class="related-card glass" href={`/services/${item.slug}`} data-reveal>
            <span class="num-tag">{groupFor(item)?.title}</span>
            <strong>{item.title}</strong>
            <span>{item.options.length} options</span>
            <Icon name="arrow" size={17} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="quote-panel glass" data-reveal>
        <div>
          <h2 class="display">Want this scoped for your brand?</h2>
          <p class="lede">
            Book a free consultation or start with the audit. Either way you leave with a clearer
            next step and a real number, not a range.
          </p>
        </div>
        <div class="actions">
          <a class="btn" href="/contact">Book a free consultation <Icon name="arrow" /></a>
          <a class="btn ghost" href="/audit">Get my free growth audit</a>
        </div>
      </div>
    </div>
  </section>
</Base>
