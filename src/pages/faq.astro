---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getData } from '../lib/data';
const { faqs, content } = await getData();
const page = content.faqPage;
const names = [...new Set(faqs.map((faq) => faq.group))];
const groups = names.map((group) => ({
  group,
  items: faqs.filter((faq) => faq.group === group),
}));
---
<Base
  title="FAQ | Answers before the first call · Zannid & Co."
  description="How fast results come, what ad spend covers, how shoots work outside India, how billing in INR and USD works, and what happens on the free audit call."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="display">{page.title}</h1>
      <p class="lede">{page.lede}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap" style="max-width:900px">
      {groups.map(({ group, items }) => (
        <div class="faq-group" data-reveal>
          <h2>{group}</h2>
          <div class="faq-list glass">
            {items.map((faq, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>{faq.q}<Icon name="plus" size={20} /></summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="cta-panel glass" style="margin-top:48px" data-reveal>
        <h2 class="display" style="font-size:clamp(1.8rem,3.4vw,2.8rem)">Still have a question?</h2>
        <p class="lede">Ask it directly. We will answer honestly, even if the answer is that we are not the right fit.</p>
        <div class="actions">
          <a class="btn" href="/contact">Ask us <Icon name="arrow" /></a>
          <a class="btn ghost" href="/audit">Get a free audit</a>
        </div>
      </div>
    </div>
  </section>
</Base>
