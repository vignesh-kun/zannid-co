---
import Base from '../layouts/Base.astro';
import ProseSections from '../components/ProseSections.astro';
import { content } from '../lib/site';
const page = content.terms;
---
<Base
  title="Terms of service | Zannid & Co."
  description="The terms that apply to using the Zannid & Co. site, quotes, payments, cancellations, intellectual property and the limits of our liability."
>
  <section class="page-hero">
    <div class="wrap prose-wrap">
      <p class="eyebrow">Legal</p>
      <h1 class="display">{page.title}</h1>
      <p class="lede">The short version: clear scopes, clear ownership, no surprise invoices.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap prose-wrap">
      <div class="prose glass" data-reveal>
        <ProseSections updated={page.updated} sections={page.sections} />
      </div>
    </div>
  </section>
</Base>
