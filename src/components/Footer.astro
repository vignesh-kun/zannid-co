---
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/site';
import { getData } from '../lib/data';
const { site, groups } = await getData();
const wa = whatsappLink(site);
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="brand" href="/" aria-label="Zannid & Co. home">
        <img class="brand-logo" src="/assets/zannid-logo.png" alt="" width="96" height="96" />
      </a>
      <p>Strategy. Content. Growth.<br />A growth agency for brands in India and worldwide.</p>
      <a class="foot-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <div class="foot-col">
      <h2>Services</h2>
      {groups.map((group) => <a href={`/services#${group.slug}`}>{group.title}</a>)}
      <a class="foot-more" href="/services">All services <Icon name="arrow" size={14} /></a>
    </div>

    <div class="foot-col">
      <h2>Company</h2>
      <a href="/work">Work</a>
      <a href="/clients">Clients</a>
      <a href="/journey">Journey</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
      <a href="/faq">FAQ</a>
      <a href="/audit">Free audit</a>
    </div>

    <div class="foot-col">
      <h2>Connect</h2>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={wa} target={wa.startsWith('http') ? '_blank' : undefined} rel="noopener">WhatsApp</a>
      <a href="/contact">Contact</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>

  <div class="wrap foot-legal">
    <span>© {year} {site.name}. All rights reserved.</span>
    <div>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</footer>
