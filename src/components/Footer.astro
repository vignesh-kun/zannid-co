---
import Icon from './Icon.astro';
import { services, siteConfig, whatsappLink } from '../lib/site';
const year = new Date().getFullYear();
const featured = services.slice(0, 5);
---
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="brand" href="/" aria-label="Zannid & Co. home">
        <svg viewBox="-6 0 150 120" aria-hidden="true">
          <g transform="skewX(-16) translate(30,0)">
            <path d="M10 28 L96 12 L104 12 L40 92 L106 84 L98 104 L8 112 L0 112 L66 34 L4 40 Z" fill="currentColor" />
            <path d="M-8 76 L126 46" class="brand-cut" stroke-width="6" />
          </g>
        </svg>
        <span class="brand-word">ZANNID</span>
        <span class="brand-co">&amp; CO.</span>
      </a>
      <p>Strategy. Content. Growth.<br />A growth agency for brands in India and worldwide.</p>
      <a class="foot-mail" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>

    <div class="foot-col">
      <h2>Services</h2>
      {featured.map((service) => <a href={`/services/${service.slug}`}>{service.shortTitle}</a>)}
      <a class="foot-more" href="/services">All ten services <Icon name="arrow" size={14} /></a>
    </div>

    <div class="foot-col">
      <h2>Company</h2>
      <a href="/work">Work</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
      <a href="/faq">FAQ</a>
      <a href="/audit">Free audit</a>
    </div>

    <div class="foot-col">
      <h2>Connect</h2>
      <a href={siteConfig.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={whatsappLink()} target={whatsappLink().startsWith('http') ? '_blank' : undefined} rel="noopener">WhatsApp</a>
      <a href="/contact">Contact</a>
      <a href={`mailto:${siteConfig.email}`}>Email</a>
    </div>
  </div>

  <div class="wrap foot-legal">
    <span>© {year} {siteConfig.name}. All rights reserved.</span>
    <div>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</footer>
