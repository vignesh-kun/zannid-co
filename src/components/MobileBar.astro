---
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/site';
import { getData } from '../lib/data';
const { site } = await getData();
const wa = whatsappLink(site);
---
<div class="mobile-bar" role="navigation" aria-label="Quick actions">
  <a class="btn sm audit" href="/audit">Get a Free Audit <Icon name="arrow" size={15} /></a>
  <a class="btn sm ghost wa" href={wa} target={wa.startsWith('http') ? '_blank' : undefined} rel="noopener">
    <Icon name="whatsapp" size={17} /> WhatsApp
  </a>
</div>
