# Copy to .env (gitignored) and fill in. Never commit real values.

# ── Admin dashboard (/admin) ─────────────────────────────────────────
# The only admin credential. Pick something long; changing it signs everyone out.
ADMIN_PASSWORD=change-me-to-something-long
# Optional. Signs the admin session cookie. Leave blank to derive it from the password.
ADMIN_SESSION_SECRET=

# ── Content storage ─────────────────────────────────────────────────
# Locally the dashboard saves to .data/content.json (gitignored, no setup).
# A deployed site has a read-only filesystem, so point it at Supabase:
# run supabase/schema.sql once, then set these two values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
